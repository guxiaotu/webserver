            const rows = [...tbody.rows];
            rows.sort((a, b) => {
                let x = a.cells[th.cellIndex].textContent.replace(/[$,%]/g, ''),
                    y = b.cells[th.cellIndex].textContent.replace(/[$,%]/g, '');
                return asc ? (parseFloat(x) - parseFloat(y)) : (parseFloat(y) - parseFloat(x));
            });
